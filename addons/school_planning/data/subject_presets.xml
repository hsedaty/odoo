<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="curriculum_us_standards" model="school.curriculum.preset">
        <field name="name">American Curriculum (Cognia Accreditation)</field>
        <field name="code">US</field>
        <field name="description">American curriculum planning for schools pursuing or holding Cognia accreditation. Cognia accredits institutions, not a single prescribed curriculum or mandatory subject list. These configurable subject options draw on commonly used American standards; select only the subjects the school offers and confirm local requirements. Selecting this preset does not establish or verify the school's accreditation status.</field>
        <field name="source_url">https://www.cognia.org/accreditation/</field>
        <field name="verified_on">2026-10-10</field>
        <field name="display_order">10</field>
    </record>
    <record id="curriculum_england" model="school.curriculum.preset">
        <field name="name">Cambridge IGCSE</field>
        <field name="code">IGCSE</field>
        <field name="description">Cambridge IGCSE is a flexible upper-secondary qualification with over 70 subjects and no universal mandatory combination. This catalog contains current international syllabuses and their codes. Subject and exam-series availability varies by administrative zone, so select only the syllabuses offered by the school.</field>
        <field name="source_url">https://www.cambridgeinternational.org/programmes-and-qualifications/cambridge-upper-secondary/cambridge-igcse/subjects/</field>
        <field name="verified_on">2026-09-25</field>
        <field name="display_order">20</field>
    </record>
    <record id="curriculum_ib_pyp" model="school.curriculum.preset">
        <field name="name">IB Primary Years Programme (PYP)</field>
        <field name="code">IB_PYP</field>
        <field name="description">IB PYP transdisciplinary subject areas. Schools organize learning through a programme of inquiry across and beyond traditional subject boundaries.</field>
        <field name="source_url">https://www.ibo.org/programmes/primary-years-programme/curriculum/</field>
        <field name="verified_on">2026-09-25</field>
        <field name="display_order">30</field>
    </record>
    <record id="curriculum_ib_myp" model="school.curriculum.preset">
        <field name="name">IB Middle Years Programme (MYP)</field>
        <field name="code">IB_MYP</field>
        <field name="description">The eight official IB MYP subject groups. In MYP years 4 and 5, permitted flexibility can reduce study to six groups within IB requirements.</field>
        <field name="source_url">https://www.ibo.org/programmes/middle-years-programme/curriculum/</field>
        <field name="verified_on">2026-09-25</field>
        <field name="display_order">40</field>
    </record>
    <record id="curriculum_ib_dp" model="school.curriculum.preset">
        <field name="name">IB Diploma Programme (DP)</field>
        <field name="code">IB_DP</field>
        <field name="description">Current IB DP courses organized into six subject groups, plus the required DP core. Actual language offerings and course availability are school-specific; select only courses the school offers.</field>
        <field name="source_url">https://www.ibo.org/programmes/diploma-programme/curriculum/</field>
        <field name="verified_on">2026-09-25</field>
        <field name="display_order">50</field>
    </record>

