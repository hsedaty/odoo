<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="school_planning.DetailedExpenses">
        <div t-if="state.data" class="o_school_detailed_expenses">
            <div class="d-flex flex-wrap justify-content-between gap-3 bg-light border rounded p-3 fw-semibold mb-2">
                <span>All Expenses (NO DETAILS)</span>
                <span class="d-flex flex-wrap gap-3">
                    <span t-if="state.data.baseline_ratio != null" class="text-muted">
                        <t t-esc="percentage(state.data.baseline_ratio) + ' ' + state.data.baseline_ratio_basis"/>
                    </span>
                    <span class="text-nowrap" t-esc="money(state.data.baseline)"/>
                </span>
            </div>
            <button t-if="!state.data.created and !state.data.locked" type="button" class="btn btn-primary"
                    t-att-disabled="state.busy" t-on-click="() => this.update('create_detailed_expense_list')">
                Create detailed expense list
            </button>
            <details t-if="state.data.created" class="border rounded" open="open">
                <summary class="bg-light p-3 fw-semibold">
                    All Expenses (DETAILED)
                    <span class="float-end text-nowrap" aria-live="polite" t-esc="money(state.data.total)"/>
                </summary>
                <div class="p-3">
                    <p class="text-muted mb-2">Select the expenses needed for this year. This estimate does not change the forecast total.</p>
                    <p t-if="!state.data.groups.length" class="text-muted mb-0">No expense seeds match this school's configured curricula.</p>
                    <p t-if="state.data.pending" class="text-warning mb-2" role="status">Subtotal only: some selected expenses are missing cost information.</p>
                    <details t-foreach="state.data.groups" t-as="group" t-key="group.name" class="border rounded mb-2">
                        <summary class="bg-light px-3 py-2 fw-semibold">
                            <t t-esc="group.name"/>
                            <span class="float-end text-nowrap" t-esc="money(group.total)"/>
                        </summary>
                        <div class="ps-3 pe-2 py-2">
                            <details t-foreach="group.categories" t-as="category" t-key="category.id" class="border rounded mb-1">
                                <summary class="px-3 py-2 fw-semibold">
                                    <t t-esc="category.name"/>
                                    <span class="float-end text-nowrap" t-esc="money(category.total)"/>
                                </summary>
                                <label t-foreach="category.items" t-as="item" t-key="item.id"
                                       class="d-flex justify-content-between flex-wrap gap-2 border-top py-2 px-3 ms-2">
                                    <span>
                                        <input type="checkbox" class="form-check-input me-2" t-att-checked="item.selected"
                                               t-att-disabled="state.data.locked or state.busy or item.student_paid"
                                               t-on-click.prevent="() => this.update('set_detailed_expense_selection', item.id, !item.selected)"/>
                                        <t t-esc="item.name"/>
                                    </span>
                                    <span class="text-muted" t-if="item.note" t-esc="item.note"/>
                                    <span class="text-nowrap" t-else="" t-esc="money(item.amount)"/>
                                </label>
                            </details>
                        </div>
                    </details>
                </div>
            </details>
        </div>
    </t>
</templates>
