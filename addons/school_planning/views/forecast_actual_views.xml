        <field name="arch" type="xml"><xpath expr="//search" position="inside"><searchpanel><field name="school_id" select="one"/><field name="dataset_type" select="one"/></searchpanel><filter name="group_dataset" string="Dataset" context="{'group_by': 'dataset_type'}"/></xpath></field>
