    </record>
    <record id="view_school_forecast_actual_summary_form" model="ir.ui.view">
        <field name="name">school.forecast.actual.summary.form</field><field name="model">school.academic.years</field><field name="inherit_id" ref="school_planning.view_school_academic_years_financial_summary_form"/>
        <field name="arch" type="xml"><xpath expr="//sheet" position="before"><header><button name="action_open_forecast" type="object" string="Open Workspace" icon="fa-pencil"/><button name="action_open_actual" type="object" string="Enter Actuals" icon="fa-pencil" invisible="dataset_type != 'forecast'"/><button name="action_open_comparison" type="object" string="Compare" icon="fa-columns" invisible="dataset_type == 'legacy'"/></header></xpath><xpath expr="//h1" position="after"><field name="dataset_type" widget="badge"/></xpath></field>
    </record>
    <record id="view_school_prediction_cost_bucket" model="ir.ui.view">
        <field name="name">school.prediction.cost.bucket</field><field name="model">school.prediction.quick.setup.wizard</field><field name="inherit_id" ref="school_planning.view_school_prediction_quick_setup_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='repeating_expense_line_ids']/list/field[@name='name']" position="attributes"><attribute name="string">Expense Category</attribute><attribute name="width">230px</attribute></xpath>
            <xpath expr="//field[@name='extreme_expense_line_ids']/list/field[@name='name']" position="attributes"><attribute name="string">Expense Category</attribute><attribute name="width">230px</attribute></xpath>
            <xpath expr="//field[@name='repeating_expense_line_ids']/list/field[@name='name']" position="after"><field name="seed_id" column_invisible="True"/><field name="school_category_id" column_invisible="True"/><field name="item_templates" column_invisible="True"/><field name="cost_bucket" column_invisible="True"/></xpath>
            <xpath expr="//field[@name='extreme_expense_line_ids']/list/field[@name='name']" position="after"><field name="seed_id" column_invisible="True"/><field name="school_category_id" column_invisible="True"/><field name="item_templates" column_invisible="True"/><field name="cost_bucket" column_invisible="True"/></xpath>
        </field>
