        <field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_open_actuals" type="object" string="Enter Actuals" icon="fa-pencil"/><button name="action_open_comparison" type="object" string="Compare" icon="fa-columns"/></xpath></field>
    </record>
