<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================= -->
    <!-- FINANCIAL REPORT (STORED SNAPSHOT) - NATIVE ANALYTICS    -->
    <!-- ======================================================= -->

    <record id="view_school_financial_report_list" model="ir.ui.view">
        <field name="name">school.financial.report.list</field>
        <field name="model">school.financial.report</field>
        <field name="arch" type="xml">
            <list string="Financial Report" create="false" edit="false" delete="false" sample="1">
                <field name="school_id"/>
                <field name="academic_year_name"/>
                <field name="dataset_type" widget="badge"/>
                <field name="total_enrolled_students" sum="Students"/>
                <field name="gross_revenue" sum="Gross Revenue"/>
                <field name="net_revenue" sum="Net Revenue"/>
                <field name="operating_cost_total" sum="Operating Cost"/>
                <field name="operating_profit" sum="Operating Profit"/>
                <field name="net_profit" sum="Net Profit" decoration-success="net_profit &gt;= 0" decoration-danger="net_profit &lt; 0"/>
                <field name="revenue_yoy_pct" string="Revenue YoY %"/>
                <field name="profit_yoy_pct" string="Profit YoY %"/>
            </list>
        </field>
    </record>

    <record id="view_school_financial_report_pivot" model="ir.ui.view">
        <field name="name">school.financial.report.pivot</field>
        <field name="model">school.financial.report</field>
        <field name="arch" type="xml">
            <pivot string="Financial Pivot Analysis" sample="1">
                <field name="school_id" type="row"/>
                <field name="dataset_type" type="row"/>
                <field name="academic_year_name" type="row"/>
                <field name="total_enrolled_students" type="measure"/>
                <field name="gross_revenue" type="measure"/>
                <field name="tax_amount" type="measure"/>
                <field name="net_revenue" type="measure"/>
                <field name="expense_total" type="measure"/>
                <field name="salary_total" type="measure"/>
                <field name="room_equipment_total" type="measure"/>
                <field name="operating_cost_total" type="measure"/>
                <field name="startup_cost_total" type="measure"/>
                <field name="operating_profit" type="measure"/>
                <field name="net_profit" type="measure"/>
                <field name="net_margin_pct" type="measure"/>
                <field name="revenue_yoy_pct" type="measure"/>
                <field name="profit_yoy_pct" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_school_financial_report_graph_yoy" model="ir.ui.view">
        <field name="name">school.financial.report.graph.yoy</field>
        <field name="model">school.financial.report</field>
        <field name="arch" type="xml">
            <graph string="YoY Growth Chart" type="line" sample="0">
                <field name="academic_year_name" type="row"/>
                <field name="dataset_type" type="row"/>
                <field name="profit_yoy_pct" type="measure"/>
                <field name="revenue_yoy_pct" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_school_financial_report_graph_profit" model="ir.ui.view">
        <field name="name">school.financial.report.graph.profit</field>
        <field name="model">school.financial.report</field>
        <field name="arch" type="xml">
            <graph string="Revenue / Expense / Profit" type="bar" sample="1">
                <field name="academic_year_name" type="row"/>
                <field name="dataset_type" type="row"/>
                <field name="gross_revenue" type="measure"/>
                <field name="operating_cost_total" type="measure"/>
                <field name="operating_profit" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_school_financial_report_form" model="ir.ui.view">
        <field name="name">school.financial.report.form</field>
        <field name="model">school.financial.report</field>
        <field name="arch" type="xml">
            <form string="Financial Report" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="academic_year_name" readonly="1"/></h1>
                        <div class="text-muted"><field name="school_id" readonly="1"/></div>
                    </div>
                    <group col="2">
                        <group string="Revenue">
                            <field name="total_enrolled_students" readonly="1"/>
                            <field name="gross_revenue" readonly="1"/>
                            <field name="tax_amount" readonly="1"/>
                            <field name="net_revenue" readonly="1"/>
                        </group>
                        <group string="Cost &amp; Profit">
                            <field name="expense_total" readonly="1"/>
                            <field name="salary_total" readonly="1"/>
                            <field name="room_equipment_total" readonly="1"/>
                            <field name="operating_cost_total" readonly="1"/>
                            <field name="startup_cost_total" readonly="1"/>
                            <field name="operating_profit" readonly="1"/>
                            <field name="net_profit" readonly="1"/>
                            <field name="net_margin_pct" readonly="1"/>
                        </group>
                    </group>
                    <group string="Year-over-Year" col="2">
                        <field name="prior_year_gross_revenue" readonly="1"/>
                        <field name="prior_year_net_revenue" readonly="1"/>
                        <field name="prior_year_net_profit" readonly="1"/>
                        <field name="revenue_yoy_pct" readonly="1"/>
                        <field name="profit_yoy_pct" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_financial_report_search" model="ir.ui.view">
        <field name="name">school.financial.report.search</field>
        <field name="model">school.financial.report</field>
        <field name="arch" type="xml">
            <search string="Financial Report">
                <searchpanel view_types="graph,pivot,list">
                    <field name="school_id" select="one" expand="1" limit="0"/>
                    <field name="dataset_type" select="one" expand="1"/>
                </searchpanel>
                <field name="school_id"/>
                <field name="academic_year_name"/>
                <filter name="filter_profitable" string="Profitable Years" domain="[('net_profit', '&gt;=', 0)]"/>
                <filter name="filter_at_risk" string="At Risk Years" domain="[('net_profit', '&lt;', 0)]"/>
                <separator/>
                <filter name="group_school" string="School" context="{'group_by': 'school_id'}"/>
                <filter name="group_year" string="Academic Year" context="{'group_by': 'academic_year_name'}"/>
                <filter name="group_dataset" string="Dataset" context="{'group_by': 'dataset_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_school_financial_report_pivot" model="ir.actions.act_window">
        <field name="name">Financial Pivot Analysis</field>
        <field name="res_model">school.financial.report</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="view_id" ref="view_school_financial_report_pivot"/>
        <field name="search_view_id" ref="view_school_financial_report_search"/>
        <field name="context">{'search_default_group_school': 1}</field>
    </record>

    <record id="action_school_financial_report_yoy_chart" model="ir.actions.act_window">
        <field name="name">YoY Growth Chart</field>
        <field name="res_model">school.financial.report</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="view_id" ref="view_school_financial_report_graph_yoy"/>
        <field name="search_view_id" ref="view_school_financial_report_search"/>
    </record>

    <record id="action_school_financial_report_profit_chart" model="ir.actions.act_window">
        <field name="name">Revenue / Expense / Profit Chart</field>
        <field name="res_model">school.financial.report</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="view_id" ref="view_school_financial_report_graph_profit"/>
        <field name="search_view_id" ref="view_school_financial_report_search"/>
    </record>

    <record id="action_school_financial_report_yoy_select_school" model="ir.actions.server">
        <field name="name">YoY Growth Chart</field>
        <field name="model_id" ref="model_school_schools"/>
        <field name="state">code</field>
        <field name="code">action = env['school.financial.report'].action_open_analytics('school_planning.action_school_financial_report_yoy_chart')</field>
    </record>
    <record id="action_school_financial_report_profit_select_school" model="ir.actions.server">
        <field name="name">Revenue / Expense / Profit Chart</field>
        <field name="model_id" ref="model_school_schools"/>
        <field name="state">code</field>
        <field name="code">action = env['school.financial.report'].action_open_analytics('school_planning.action_school_financial_report_profit_chart')</field>
    </record>
    <record id="action_school_financial_report_pivot_select_school" model="ir.actions.server">
        <field name="name">Financial Pivot Analysis</field>
        <field name="model_id" ref="model_school_schools"/>
        <field name="state">code</field>
        <field name="code">action = env['school.financial.report'].action_open_analytics('school_planning.action_school_financial_report_pivot')</field>
    </record>

    <menuitem id="menu_school_financial_report_yoy_chart" name="YoY Growth Chart" parent="menu_school_planning_overview" action="action_school_financial_report_yoy_select_school" sequence="4"/>
    <menuitem id="menu_school_financial_report_profit_chart" name="Revenue / Expense / Profit Chart" parent="menu_school_planning_overview" action="action_school_financial_report_profit_select_school" sequence="5"/>
    <menuitem id="menu_school_financial_report_pivot" name="Financial Pivot Analysis" parent="menu_school_planning_overview" action="action_school_financial_report_pivot_select_school" sequence="6"/>

</odoo>
