<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="school_planning.DetailedExpenses">
        <div t-if="state.data" class="o_school_detailed_expenses">
            <div class="d-flex flex-wrap justify-content-between gap-3 bg-light border rounded p-3 fw-semibold mb-2">
                <span t-esc="kind === 'income' ? (state.data.historic_frozen ? 'Historical fee income' : 'income from tuition ONLY') : 'All Expenses (NO DETAILS)'"/>
                <span class="d-flex flex-wrap gap-3">
                    <span t-if="state.data.baseline_ratio != null" class="text-muted">
                        <t t-esc="percentage(state.data.baseline_ratio) + ' ' + state.data.baseline_ratio_basis"/>
                    </span>
                    <span class="text-nowrap" t-esc="money(kind === 'income' ? this.tuitionTotal : state.data.baseline)"/>
                </span>
            </div>
            <button t-if="!state.data.created and !state.data.locked" type="button" class="btn btn-primary"
                    t-att-disabled="state.busy" t-on-click="() => this.createList()">
                <t t-esc="kind === 'income' ? 'Create detailed income list' : 'Create detailed expense list'"/>
            </button>
            <p t-if="kind === 'expense' and !state.data.created and !state.data.locked" class="text-muted mt-2">
                Create a detailed list, then choose which expenses to use in reports.
            </p>
            <details t-if="state.data.created or kind === 'income'" class="border rounded" open="open">
                <summary class="bg-light p-3 fw-semibold">
                    <t t-esc="kind === 'income' ? 'All Income (DETAILED)' : 'All Expenses (DETAILED)'"/>
                    <span class="float-end text-nowrap" aria-live="polite" t-esc="money(kind === 'income' and !state.data.historic_frozen ? props.record.data.fee_gross_total : state.data.total)"/>
                </summary>
                <div class="p-3">
                    <button t-if="kind === 'expense' and !state.data.locked" type="button" class="btn btn-outline-danger btn-sm mb-2"
                            t-att-disabled="state.busy" t-on-click="() => this.deleteList()">Delete detailed expense list</button>
                    <p t-if="kind === 'expense'" class="text-muted mb-2">Enter an amount or a percentage of revenue before tax for this year. Complete prices before selecting Detailed for reports. Other years are unchanged.</p>
                    <p t-elif="state.data.historic_frozen" class="text-muted mb-2">This forecast was approved before Detailed Income was included in totals. Its approved figures remain unchanged.</p>
                    <p t-elif="state.data.locked" class="text-muted mb-2">This approved income breakdown and its totals are preserved.</p>
                    <p t-else="" class="text-muted mb-2">Tuition is included automatically. Percentages use tuition revenue before tax. Changing a per-student average resets its grade amounts.</p>
                    <p t-if="kind === 'income' and props.record.dirty" class="text-muted mb-2" role="status">Save changes to refresh the income breakdown.</p>
                    <p t-if="state.data.created and !state.data.groups.length" class="text-muted mb-0">No seeds match this school's configured curricula.</p>
                    <DismissibleNotice t-if="state.data.pending" t-key="state.data.pending" variant="'inline-warning'">Subtotal only: some selected items are missing price information.</DismissibleNotice>
                    <details t-foreach="state.data.groups" t-as="group" t-key="group.name" class="border rounded mb-2">
                        <summary class="bg-light px-3 py-2 fw-semibold">
                            <t t-esc="group.name"/>
                            <span class="float-end text-nowrap" t-esc="money(group.total)"/>
                        </summary>
                        <div class="ps-3 pe-2 py-2">
                            <details t-foreach="group.categories" t-as="category" t-key="category.id"
                                     class="border rounded mb-1" t-att-open="category.name === group.name ? true : undefined">
                                <summary t-att-class="category.name === group.name ? 'd-none' : 'px-3 py-2 fw-semibold'">
                                    <t t-esc="category.name"/>
                                    <span t-if="category.price_type" class="badge text-bg-light ms-2" t-esc="category.price_type === 'fixed' ? 'Fixed' : 'Allocated'"/>
                                    <span class="float-end text-nowrap" t-esc="money(category.total)"/>
                                </summary>
                                <div t-foreach="category.items" t-as="item" t-key="item.id"
                                       class="d-flex justify-content-between flex-wrap gap-2 border-top py-2 px-3 ms-2">
                                    <label>
                                        <input type="checkbox" class="form-check-input me-2" t-att-checked="item.selected"
                                               t-att-disabled="state.data.locked or state.busy or item.student_paid"
                                               t-on-click.prevent="() => this.selectItem(item)"/>
                                        <t t-esc="item.name"/>
                                        <span class="badge text-bg-light ms-2" t-esc="item.price_type === 'fixed' ? 'Fixed' : 'Allocated'"/>
                                    </label>
                                    <div t-if="kind === 'income' and item.selected and item.basis === 'student' and !item.student_paid" class="d-flex align-items-center gap-2">
                                        <label class="d-flex align-items-center gap-2">
                                            Average / student
                                            <input type="number" min="0" step="any" class="form-control form-control-sm" style="width: 9rem"
                                                   t-att-aria-label="'Average per student for ' + item.name"
                                                   t-att-value="item.grade_average == null ? '' : item.grade_average"
                                                   t-att-disabled="state.data.locked or state.busy"
                                                   t-on-change="(ev) => this.setGradeAmount(item, false, ev)"/>
                                        </label>
                                        <button t-if="item.occurrence_mode" type="button" class="btn btn-link btn-sm"
                                                t-att-disabled="state.data.locked or state.busy"
                                                t-on-click="() => this.resetOccurrence(item)">Use default</button>
                                    </div>
                                    <div t-if="item.selected and !item.student_paid and !(kind === 'income' and item.basis === 'student')" class="d-flex align-items-center flex-wrap gap-2">
                                        <label class="d-flex align-items-center gap-2">
                                            <span class="small">This year</span>
                                            <select class="form-select form-select-sm" t-att-aria-label="'Amount type for ' + item.name"
                                                    t-att-disabled="state.data.locked or state.busy"
                                                    t-att-value="this.occurrenceMode(item)"
                                                    t-on-change="(ev) => this.setOccurrenceMode(item, ev)">
                                                <option value="amount" t-att-selected="this.occurrenceMode(item) === 'amount'">Amount</option>
                                                <option value="revenue_percent" t-att-selected="this.occurrenceMode(item) === 'revenue_percent'"><t t-esc="kind === 'income' ? '% of tuition before tax' : '% of revenue before tax'"/></option>
                                                <option t-if="item.basis === 'student_percent' or item.occurrence_mode === 'student_percent'" value="student_percent" t-att-selected="this.occurrenceMode(item) === 'student_percent'">Per Student in %</option>
                                            </select>
                                        </label>
                                        <label t-if="this.occurrenceMode(item) === 'student_percent'" class="d-flex align-items-center gap-2">
                                            <span class="small">Amount / student (<t t-esc="state.data.currency_name"/>)</span>
                                            <input type="number" min="0" step="any" class="form-control form-control-sm" style="width: 9rem"
                                                   t-att-aria-label="'Amount per student for ' + item.name"
                                                   t-att-value="item.occurrence_mode === 'student_percent' ? item.occurrence_value : ''"
                                                   t-att-disabled="state.data.locked or state.busy"
                                                   t-on-change="(ev) => this.setStudentPercentage(item, 'amount', ev)"/>
                                        </label>
                                        <label t-if="this.occurrenceMode(item) === 'student_percent'" class="d-flex align-items-center gap-2">
                                            <span class="small">Participating students %</span>
                                            <input type="number" min="0" max="100" step="any" class="form-control form-control-sm" style="width: 7rem"
                                                   t-att-aria-label="'Participation percentage for ' + item.name"
                                                   t-att-value="item.occurrence_mode === 'student_percent' ? item.occurrence_percentage : ''"
                                                   t-att-disabled="state.data.locked or state.busy"
                                                   t-on-change="(ev) => this.setStudentPercentage(item, 'percentage', ev)"/>
                                        </label>
                                        <label t-if="this.occurrenceMode(item) !== 'student_percent'" class="d-flex align-items-center gap-2">
                                            <span class="small" t-esc="this.occurrenceMode(item) === 'amount' ? state.data.currency_name : '%'"/>
                                            <input type="number" min="0" step="any" class="form-control form-control-sm" style="width: 9rem"
                                                   t-att-aria-label="'This year for ' + item.name"
                                                   t-att-value="this.occurrenceValue(item) == null ? '' : this.occurrenceValue(item)"
                                                   t-att-disabled="state.data.locked or state.busy"
                                                   t-on-change="(ev) => this.setOccurrence(item, ev)"/>
                                        </label>
                                        <span t-if="item.occurrence_mode and item.occurrence_mode !== this.occurrenceMode(item)"
                                              class="text-muted small">Enter a value to apply this type.</span>
                                        <button t-if="item.occurrence_mode" type="button" class="btn btn-link btn-sm"
                                                t-att-disabled="state.data.locked or state.busy"
                                                t-on-click="() => this.resetOccurrence(item)">Use default</button>
                                    </div>
                                    <span class="text-muted" t-if="item.note" t-esc="item.note"/>
                                    <span class="text-nowrap" t-else="" t-esc="money(item.amount)"/>
                                </div>
                            </details>
                        </div>
                    </details>
                </div>
            </details>
        </div>
    </t>
</templates>
