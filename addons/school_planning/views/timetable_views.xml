<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_school_timetable_list" model="ir.ui.view">
        <field name="name">school.timetable.list</field>
        <field name="model">school.timetable</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="curriculum_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_school_timetable_form" model="ir.ui.view">
        <field name="name">school.timetable.form</field>
        <field name="model">school.timetable</field>
        <field name="arch" type="xml">
            <form string="Timetable Seed">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Timetable name"/></h1></div>
                    <group><field name="curriculum_id" options="{'no_create': True}"/></group>
                    <widget name="school_dismissible_notice" variant="info" string="Weekly hours per class, by grade. Zero means not taught in that grade. Electives are separate subjects sharing a label such as ELCT1 or ELCT2. Counted Class Hours counts each area once per grade, using its largest subject duration. No student split is needed; both subjects remain in teacher planning. New predictions use this seed automatically for schools offering its curriculum. Existing years change only when you load timetables in Teaching Load."/>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" limit="200">
                            <field name="curriculum_id" column_invisible="True"/>
                            <field name="grade_id" options="{'no_create': True}"/>
                            <field name="subject_id" domain="[('curriculum_id', '=', curriculum_id)]" options="{'no_create': True}"/>
                            <field name="elective_group" placeholder="ELCT1"/>
                            <field name="weekly_hours"/>
                            <field name="class_weekly_hours" sum="Class Hours"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_school_timetables" model="ir.actions.act_window">
        <field name="name">Timetables</field>
        <field name="res_model">school.timetable</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_school_timetables" name="Timetables" parent="menu_config_academic" action="action_school_timetables" sequence="7"/>
</odoo>
